public boolean isTwoColorableTree() {
/** ASSESSMENT
 * @grade 4
 * @feedback rear index is not advanced after placing the root, so the queue appears empty (-1)
 */
        TreeNode[] quArray = new TreeNode[100];
        TreeNode[] colors = new TreeNode[100];

        for (int i =0;i<100;i++) {
            colors[i] = new TreeNode(2);
        }

        int first = 0;
        int last = first;
        TreeNode temp = getRoot();
        TreeNode tempColor = colors[0];
        quArray[0]=temp;

/** ASSESSMENT
 * @grade 11
 * @feedback BFS loop is blocked by the unadvanced rear index (-1); left child gets the parent color when both children exist (-1); right child gets the parent color when both children exist (-1)
 */
        while (temp!=null) {
            if (first != last){
                temp = quArray[first];
                tempColor = colors[first];
                first = (first+1)%100;
            } else {break;}
            TreeNode child=null;
            TreeNode colorChild=null;

            if (temp.getLeft()!=null && temp.getRight()==null) {
                child = temp.getLeft();
                colorChild = new TreeNode(3-tempColor.getData());
            } else if (temp.getLeft()==null && temp.getRight()!=null) {
                child = temp.getRight();
                colorChild = new TreeNode(3-tempColor.getData());

            } else if (temp.getLeft()!=null && temp.getRight()!=null) {
                colorChild = new TreeNode(3-tempColor.getData());

                child = temp.getRight();
                quArray[last]=child;
                colors[last]=new TreeNode(3-colorChild.getData());
                last = (last+1)%100;

                child = temp.getLeft();
                quArray[last]=child;
                colors[last]=new TreeNode(3-colorChild.getData());
                last = (last+1)%100;
            } else if (temp.getLeft()==null && temp.getRight()==null) {
                continue;
            }

            if (!(temp.getLeft()!=null && temp.getRight()!=null)) {
                quArray[last]=child;
                colors[last]=colorChild;
                last = (last+1)%100;
                if (first == last) break;
                }

            if (tempColor.getData()==colorChild.getData()) {return false;}
        }

/** ASSESSMENT
 * @grade 1
 * @feedback Correct.
 */
        return true;
    }





