public boolean isTwoColorable() {
/** ASSESSMENT
 * @grade 5
 * @feedback 
 */
        boolean[] visited = new boolean[vertexCount];
        if (vertexCount<=2) return true;
        int[] colors = new int[vertexCount];
        for (int i=0;i<vertexCount;i++) {
            colors[i]=3; // 3 is not colored yet 2 is color1 and 1 is color2
            visited[i]=false;
        }
        Edge edge;
        int fromNode, toNode;
        Queue queue = new Queue();
        queue.enqueue(new Node(edges[0].getHead().getFrom()));
/** ASSESSMENT
 * @grade 14
 * @feedback 
 */
        while (!queue.isEmpty()){
            fromNode = queue.dequeue().getData();
            edge = edges[fromNode].getHead();
            while (edge != null) {
                toNode = edge.getTo();
                if (!visited[toNode]){
                    visited[toNode] = true;
                    queue.enqueue(new Node(toNode));
                }
                if (colors[toNode]==3) {colors[toNode] = 3-colors[edge.getFrom()];}
                if (colors[toNode]==colors[edge.getFrom()] || colors[edge.getFrom()]==colors[edge.getTo()]) return false;
                edge = edge.getNext();
            }
        }
/** ASSESSMENT
 * @grade 1
 * @feedback 
 */
        return true;
    }


