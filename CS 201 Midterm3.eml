public boolean isTwoColorable() {
/** ASSESSMENT
 * @grade 5
 * @feedback 
 */
        int n = edges.length;
        int[] color = new int[n];
        for (int i=0; i < n; i++)
            color[i] = -1;

        int[] queue = new int[n];
        int head = 0, tail = 0;

        color[0] = 0;
        queue[tail++] = 0;

/** ASSESSMENT
 * @grade 14
 * @feedback 
 */
        while (head < tail) {
            int v = queue[head++];

            for (Edge p = edges[v].getHead(); p != null; p = p.getNext()) {
                int w = p.getTo();

                if (color[w] == -1) {
                    color[w] = 1 - color[v];
                    queue[tail++] = w;
                } else if (color[w] == color[v]) {
                    return false;
                }
            }
        }

/** ASSESSMENT
 * @grade 1
 * @feedback 
 */
        return true;
}



