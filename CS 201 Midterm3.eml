        for (int i=0;i<count;i++) {
            for (int j=i+1;j<count;j++) {
                //findset and height for i
                int parent1 = sets[i].getParent();
                int heightofi=0;
                int tmp =i;
                while (parent1 != i){
                    i = parent1;
                    parent1 = sets[i].getParent();
                    heightofi++;
                }
                int setofi = parent1;
                i=tmp;
                //findset and height for j
                int parent2 = sets[j].getParent();
                int heightofj=0;
                tmp=j;
                while (parent2 != j){
                    j = parent2;
                    parent2 = sets[j].getParent();
                    heightofj++;
                }
                j=tmp;
                int setofj = parent2;
                if (setofj!=setofi && heightofj==heightofi) {
                    total++;
                }


            }
        }
/** ASSESSMENT
 * @grade 1
 * @feedback 
 */
        return total;
    }




