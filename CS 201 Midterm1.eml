public boolean subStackReverse(Stack sub) {
/** ASSESSMENT
 * @grade 2
 * @feedback 
 */
        Stack reverse = new Stack();
        Node current = sub.top;

/** ASSESSMENT
 * @grade 7
 * @feedback 
 */
        while (current != null) {
            Node newNode = new Node(current.data);
            newNode.next = reverse.top;
            reverse.top = newNode;
            current = current.next;
        }

/** ASSESSMENT
 * @grade 10
 * @feedback 
 */
        Node start = this.top;
        while (start != null) {
            Node p1 = start;
            Node p2 = reverse.top;

            while (p1 != null && p2 != null && p1.data == p2.data) {
                p1 = p1.next;
                p2 = p2.next;
            }

            if (p2 == null) {
                return true;
            }

            start = start.next;
        }

/** ASSESSMENT
 * @grade 1
 * @feedback 
 */
        return false;
}



