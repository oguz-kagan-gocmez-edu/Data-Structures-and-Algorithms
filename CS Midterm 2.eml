public int cubicSumOfTree() {
/** ASSESSMENT
 * @grade 3
 * @feedback Correct sum initialization, stack creation, and pushing the root.
 */
        int s =0;
        Stack sitek = new Stack(1000);
        sitek.push(getRoot());
/** ASSESSMENT
 * @grade 15
 * @feedback Correct traversal: loop until stack empty, pop, cube the key into sum, and push both children. Null children are pushed but filtered by the null check after popping, so every node is still visited exactly once. Minor: pushes/pops TreeNode directly instead of wrapping in Element.
 */
        while (!sitek.isEmpty()) {
            TreeNode top = sitek.pop();
            if (top!=null) {
                s += top.getData() * top.getData() * top.getData();
                sitek.push(top.getLeft());
                sitek.push(top.getRight());
            }
        }
/** ASSESSMENT
 * @grade 1
 * @feedback Correct return of accumulated sum.
 */
        return s;
    }




