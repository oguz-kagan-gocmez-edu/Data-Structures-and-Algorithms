 * @feedback 
 */
        int sum = 0;
        Stack stack = new Stack(100);
        stack.push(new Element(root));

/** ASSESSMENT
 * @grade 16
 * @feedback 
 */
        while (!stack.isEmpty()) {
            TreeNode current = stack.pop().getData();

            int key = current.getData();
            sum += key * key * key;

            if (current.getLeft() != null) {
                stack.push(new Element(current.getLeft()));
            }

            if (current.getRight() != null) {
                stack.push(new Element(current.getRight()));
            }
        }

/** ASSESSMENT
 * @grade 1
 * @feedback 
 */
        return sum;
}





