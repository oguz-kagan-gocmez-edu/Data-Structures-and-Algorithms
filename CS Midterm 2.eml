public static boolean isSubtree(TreeNode T1, TreeNode T2) {
/** ASSESSMENT
 * @grade 6
 * @feedback 
 */
        if (T1.toString()==T2.toString()) {return true;}
        // find T2 in T1

/** ASSESSMENT
 * @grade 14
 * @feedback 
 */
        if (T1.getData()==T2.getData()) {
            boolean leftCheck;
            boolean rightCheck;

            if (T1.getLeft()!=null && T2.getLeft()!=null) {
                leftCheck = isSubtree(T1.getLeft(), T2.getLeft());
            }
            else if (T1.getLeft()!=null && T2.getLeft()==null) {
                leftCheck=false;
            }
            else {
                leftCheck=false;
            }
            if (T1.getRight()!=null && T2.getRight()!=null) {
                rightCheck=isSubtree(T1.getRight(),T2.getRight());
            }
            else if (T1.getRight()!=null && T2.getRight()==null) {
                rightCheck=false;
            }
            else {
                rightCheck=false;
            }

            return leftCheck && rightCheck;
        }
        else if (T1.getData()!=T2.getData()) {
            if (T1.getData()>T2.getData()) {
                return isSubtree(T1.getLeft(), T2);
            }
            else if (T1.getData()<T2.getData()) {
                return isSubtree(T1.getRight(), T2);
            }
        }


/** ASSESSMENT
 * @grade 0 
 * @feedback 
 */
        return true;
    }


