public static boolean equalTripletMultiplication(int[] array) {
/** ASSESSMENT
 * @grade 3
 * @feedback Uses n^4 Hash sizing (-1).
 */
        Hash hes = new Hash((int)Math.pow(array.length, 4));
        int l = array.length;
/** ASSESSMENT
 * @grade 13
 * @feedback Duplicate check scans the table after insertion and is unreliable (-2).
 */
        for (int i =0;i<l;i++) {
            for (int j=i+1;j<l;j++) {
                for (int k=j+1;k<l;k++) {
                    int s = array[i] * array[j] * array[k];
                    hes.insert(s);
                }
            }
        }

        l = hes.table.length;
        for (int i =0;i<l;i++) {
            for (int j=0;j<l;j++) {
                if (i!=j && hes.table[i]!=null && hes.table[j]!=null && hes.table[i].getData()==hes.table[j].getData()) {
                    return true;
                }
            }
        }


/** ASSESSMENT
 * @grade 1
 * @feedback Correct.
 */
        return false;
    }



